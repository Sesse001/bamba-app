# Bamba V2 — Environment Variables
#
# Copy this file to `.env` and fill in the real values from Firebase Console:
#   Project Settings → Your apps → Web app → SDK setup and configuration → Config
#
# Then run: npx expo start --clear
#
# ⚠️ `.env` is gitignored — never commit the real values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=